<?xml version="1.0" encoding="UTF-8"?>
<!--
  KeepAlive the pre-open dashboard daemon.

  Install:
    cp launchd/com.jericle.opendash.plist ~/Library/LaunchAgents/
    # edit the two path placeholders below if you moved the project
    launchctl load ~/Library/LaunchAgents/com.jericle.opendash.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.jericle.opendash.plist
    rm ~/Library/LaunchAgents/com.jericle.opendash.plist

  The pre-open *notification* is a separate job, see launchd/preopen_alert.sh.
  It is a self-rescheduling loop rather than StartCalendarInterval because the
  ET->Sydney offset changes with both sides' daylight saving.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jericle.opendash</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/jeRiCle_SSD/Business_Analytics/BA_Projects/JericleProject/target/release/opendash</string>
        <string>serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/jeRiCle_SSD/Business_Analytics/BA_Projects/JericleProject</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OPENDASH_DIR</key>
        <string>/Volumes/jeRiCle_SSD/Business_Analytics/BA_Projects/JericleProject</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Volumes/jeRiCle_SSD/Business_Analytics/BA_Projects/JericleProject/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/jeRiCle_SSD/Business_Analytics/BA_Projects/JericleProject/data/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
