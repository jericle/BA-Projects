# Ignore heavy data files on the external SSD
*.csv
*.xlsx
*.parquet
*.json
data/
datasets/

# Ignore Python & R environment tracking junk
__pycache__/
.venv/
.Rhistory
.RData
.DS_Store

# Ignore installed R packages
R-Library/

# Ignore local AI and tool configuration folders
.agents/
.claude/
.vscode/

# Generated by Cargo
# Contains compiled files, build artifacts, and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable (binary application)
# Leave it listed here if you are building a library
Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these to store debugging information
*.pdb

# Compiler error stack traces
rustc-ice-*.txt

# migrate from .clineignore
.cline
node_modules/
.git/
dist/
build/
.next/
*.log
.aider*

# Projects that have their own repository
# JericleProject is opendash, which now lives at github.com/jericle/opendash
# as a private repo with its own history and tags. It stays here on disk as the
# working copy; it is just no longer tracked by this one.
JericleProject/
